{
  "_description": "NGM Revit ecosystem registry. Describes all scripts, families, and capabilities available. Read by NGM API to serve to the Project Builder web UI.",
  "version": "1.0",
  "schemas": {
    "manifest": {
      "file": "manifests/_schema.json",
      "description": "JSON Schema for the geometry build manifest (levels, grids, walls, fixtures, floors, columns, beams, rooms, views, sheets)"
    },
    "batch": {
      "file": "manifests/_batch_schema.json",
      "description": "JSON Schema for the complete build batch package (wraps definitions, families, materials, and manifest into a single contract)"
    }
  },
  "panels": {
    "build": {
      "label": "Build",
      "description": "Build Revit models from manifest configuration files",
      "scripts": [
        {
          "id": "build_from_batch",
          "name": "Build From Batch",
          "description": "Reads a batch JSON and builds the complete Revit model. Creates levels, grids, wall/floor types from definitions, loads families, places walls, floors, columns, beams, fixtures, and rooms. Steps 13-19 (graphic styles, shared params, views, sheets, templates, naming, save) are stubbed for future implementation.",
          "status": "ready",
          "inputs": ["batch.json", "manifest.json"],
          "creates": ["levels", "grids", "wall_types", "walls", "fixtures", "floors", "columns", "beams", "rooms"]
        },
        {
          "id": "load_definitions",
          "name": "Load Definitions",
          "description": "Applies wall types, floor types, and graphic styles from definitions to the active Revit document without placing geometry",
          "status": "planned",
          "inputs": ["definitions/wall_types.json", "definitions/floor_types.json", "definitions/graphic_styles.json"]
        }
      ]
    },
    "export": {
      "label": "Export",
      "description": "Extract data from Revit models to JSON for estimator and analysis",
      "scripts": [
        {
          "id": "export_quantities",
          "name": "Export Quantities",
          "description": "Groups elements by Family+Type with count, area, and volume totals. Output compatible with NGM estimator.",
          "status": "ready",
          "outputs": ["quantities_{project}_{timestamp}.json"],
          "categories": ["Walls", "Floors", "Roofs", "Structural Columns", "Structural Framing", "Foundations", "Doors", "Windows", "Stairs", "Rebar"]
        },
        {
          "id": "export_materials",
          "name": "Export Materials",
          "description": "Extracts all materials from model elements with area and volume per material. Includes material summary.",
          "status": "ready",
          "outputs": ["materials_{project}_{timestamp}.json"]
        },
        {
          "id": "export_spaces",
          "name": "Export Spaces",
          "description": "Extracts Rooms with floor area, perimeter, wall area, and finish assignments. Includes level summary.",
          "status": "ready",
          "outputs": ["spaces_{project}_{timestamp}.json"]
        }
      ]
    },
    "drawings": {
      "label": "Drawings",
      "description": "Automated drawing package generation",
      "scripts": [
        {
          "id": "generate_sheets",
          "name": "Generate Sheets",
          "description": "Creates sheets with viewports based on template configuration. Applies titleblock, positions views.",
          "status": "planned"
        },
        {
          "id": "export_pdf",
          "name": "Export PDF",
          "description": "Exports all sheets to PDF with correct print settings.",
          "status": "planned"
        }
      ]
    },
    "tools": {
      "label": "Tools",
      "description": "Model maintenance and quality assurance utilities",
      "scripts": [
        {
          "id": "purge_model",
          "name": "Purge Model",
          "description": "Removes unused families, types, materials, and views from the model.",
          "status": "planned"
        },
        {
          "id": "rename_views",
          "name": "Rename Views",
          "description": "Renames all views and sheets to match NGM naming conventions.",
          "status": "planned"
        },
        {
          "id": "model_qa",
          "name": "Model QA",
          "description": "Runs quality checks: unplaced rooms, duplicate types, missing parameters, unnamed elements.",
          "status": "planned"
        }
      ]
    },
    "sync": {
      "label": "Sync",
      "description": "Bidirectional sync between Revit model and NGM API",
      "scripts": [
        {
          "id": "sync_materials",
          "name": "Sync Materials",
          "description": "Pushes model materials to NGM API and pulls updated material costs back into Revit parameters.",
          "status": "planned"
        },
        {
          "id": "push_to_estimator",
          "name": "Push to Estimator",
          "description": "Exports quantities and pushes directly to a linked NGM project estimator via API.",
          "status": "planned"
        }
      ]
    }
  },
