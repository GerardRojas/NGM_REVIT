<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NGM.RevitBridge</RootNamespace>
    <AssemblyName>NGM.RevitBridge</AssemblyName>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Revit API references - adjust path to your Revit install -->
  <ItemGroup>
    <PackageReference Include="Autodesk.Revit.SDK" Version="2024.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- Copy .addin manifest to output -->
  <ItemGroup>
    <None Include="RevitBridge.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
