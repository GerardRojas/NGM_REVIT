{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NGM Build Manifest",
  "description": "Contrato entre NGM HUB Web (o edicion manual) y pyRevit Build Engine. Define todo lo necesario para construir un modelo Revit desde cero.",
  "type": "object",
  "required": ["meta", "levels"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["project_name", "project_type"],
      "properties": {
        "project_name": {"type": "string", "description": "Nombre del proyecto"},
        "project_type": {"type": "string", "enum": ["residential", "commercial", "industrial"]},
        "created_by": {"type": "string", "enum": ["manual", "ocr_tool", "web_configurator"]},
        "version": {"type": "string", "default": "1.0"},
        "ngm_project_id": {"type": "string", "description": "UUID del proyecto en NGM HUB (para sync)"}
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "elevation_m"],
        "properties": {
          "name": {"type": "string"},
          "elevation_m": {"type": "number"}
        }
      }
    },
    "grids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "start", "end"],
        "properties": {
          "name": {"type": "string"},
          "start": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "end": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "level", "start", "end"],
        "properties": {
          "type": {"type": "string", "description": "Debe coincidir con un name en definitions/wall_types.json"},
          "level": {"type": "string", "description": "Debe coincidir con un name en levels"},
          "start": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "end": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "height_m": {"type": "number", "description": "Si omitido, usa altura del nivel"},
          "structural": {"type": "boolean", "default": false}
        }
      }
    },
    "fixtures": {
      "type": "array",
      "description": "Puertas, ventanas, fixtures MEP - cualquier familia hosted o libre",
      "items": {
        "type": "object",
        "required": ["family", "point", "level"],
        "properties": {
          "family": {"type": "string", "description": "Nombre de la familia en vault (sin .rfa)"},
          "type": {"type": "string", "description": "Nombre del tipo dentro de la familia"},
          "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 3},
          "level": {"type": "string"},
          "host_wall_index": {"type": "integer", "description": "Index del muro host en el array walls (para puertas/ventanas)"},
          "rotation_deg": {"type": "number", "default": 0}
        }
      }
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "level", "boundary"],
        "properties": {
          "type": {"type": "string", "description": "Debe coincidir con definitions/floor_types.json"},
          "level": {"type": "string"},
          "boundary": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "description": "Poligono cerrado de puntos [x,y]"}
        }
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "point", "base_level", "top_level"],
        "properties": {
          "family": {"type": "string"},
          "type": {"type": "string"},
          "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "base_level": {"type": "string"},
          "top_level": {"type": "string"},
          "rotation_deg": {"type": "number", "default": 0}
        }
      }
    },
    "beams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "start", "end", "level"],
        "properties": {
          "family": {"type": "string"},
          "type": {"type": "string"},
          "start": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "end": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "level": {"type": "string"}
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "point", "level"],
        "properties": {
          "name": {"type": "string"},
          "number": {"type": "string"},
          "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "level": {"type": "string"},
          "floor_finish": {"type": "string"},
          "wall_finish": {"type": "string"},
          "ceiling_finish": {"type": "string"}
        }
      }
    },
    "views": {
      "oneOf": [
        {"type": "string", "enum": ["use_template_defaults"]},
        {"type": "array", "items": {"type": "object"}}
      ],
      "default": "use_template_defaults"
    },
    "sheets": {
      "oneOf": [
        {"type": "string", "enum": ["use_template_defaults"]},
        {"type": "array", "items": {"type": "object"}}
      ],
      "default": "use_template_defaults"
    }
  }
}
