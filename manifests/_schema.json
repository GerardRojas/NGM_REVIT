{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NGM Build Manifest",
  "description": "Contract between NGM HUB Web (or manual editing) and pyRevit Build Engine. All coordinates and dimensions in decimal feet (Revit internal units).",
  "type": "object",
  "required": ["meta", "levels"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["project_name", "project_type"],
      "properties": {
        "project_name": {"type": "string", "description": "Project name"},
        "project_type": {"type": "string", "enum": ["residential", "commercial", "industrial"]},
        "created_by": {"type": "string", "enum": ["manual", "ocr_tool", "web_configurator"]},
        "version": {"type": "string", "default": "1.0"},
        "ngm_project_id": {"type": "string", "description": "Project UUID in NGM HUB (for sync)"}
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "elevation_ft"],
        "properties": {
          "name": {"type": "string"},
          "elevation_ft": {"type": "number", "description": "Elevation in decimal feet"}
        }
      }
    },
    "grids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "start", "end"],
        "properties": {
          "name": {"type": "string"},
          "start": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "[x, y] in feet"},
          "end": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "[x, y] in feet"}
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "level", "start", "end"],
        "properties": {
          "type": {"type": "string", "description": "Must match a name in definitions/wall_types.json"},
          "level": {"type": "string", "description": "Must match a name in levels"},
          "start": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "[x, y] in feet"},
          "end": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "[x, y] in feet"},
          "height_ft": {"type": "number", "description": "Wall height in feet. If omitted, uses level height"},
          "structural": {"type": "boolean", "default": false}
        }
      }
    },
    "fixtures": {
      "type": "array",
      "description": "Doors, windows, MEP fixtures - any hosted or freestanding family",
      "items": {
        "type": "object",
        "required": ["family", "point", "level"],
        "properties": {
          "family": {"type": "string", "description": "Family name in vault (without .rfa)"},
          "type": {"type": "string", "description": "Type name within the family"},
          "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 3, "description": "[x, y] or [x, y, z] in feet"},
          "level": {"type": "string"},
          "host_wall_index": {"type": "integer", "description": "Index of host wall in walls array (for doors/windows)"},
          "rotation_deg": {"type": "number", "default": 0}
        }
      }
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "level", "boundary"],
        "properties": {
          "type": {"type": "string", "description": "Must match definitions/floor_types.json"},
          "level": {"type": "string"},
          "boundary": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "description": "Closed polygon of [x,y] points in feet"}
        }
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "point", "base_level", "top_level"],
        "properties": {
          "family": {"type": "string"},
          "type": {"type": "string"},
          "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "[x, y] in feet"},
          "base_level": {"type": "string"},
          "top_level": {"type": "string"},
          "rotation_deg": {"type": "number", "default": 0}
        }
      }
    },
    "beams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "start", "end", "level"],
        "properties": {
          "family": {"type": "string"},
          "type": {"type": "string"},
          "start": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3, "description": "[x, y, z] in feet"},
          "end": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3, "description": "[x, y, z] in feet"},
          "level": {"type": "string"}
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "point", "level"],
        "properties": {
          "name": {"type": "string"},
          "number": {"type": "string"},
          "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "[x, y] in feet"},
          "level": {"type": "string"},
          "floor_finish": {"type": "string"},
          "wall_finish": {"type": "string"},
          "ceiling_finish": {"type": "string"}
        }
      }
    },
    "views": {
      "oneOf": [
        {"type": "string", "enum": ["use_template_defaults"]},
        {"type": "array", "items": {"type": "object"}}
      ],
      "default": "use_template_defaults"
    },
    "sheets": {
      "oneOf": [
        {"type": "string", "enum": ["use_template_defaults"]},
        {"type": "array", "items": {"type": "object"}}
      ],
      "default": "use_template_defaults"
    }
  }
}
